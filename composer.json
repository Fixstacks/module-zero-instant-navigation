{
    "name": "zerofront/module-zero-instant-navigation",
    "description": "Zero for Magento Open Source: the next page loads while the shopper still points at its link (Speculation Rules API).",
    "type": "magento2-module",
    "version": "1.3.3",
    "license": [
        "OSL-3.0",
        "AFL-3.0"
    ],
    "authors": [
        {
            "name": "Roman Pasichnyk"
        }
    ],
    "homepage": "https://zerofront.dev",
    "keywords": [
        "magento",
        "magento2",
        "magento-open-source",
        "zero",
        "speculation-rules",
        "prerender",
        "performance"
    ],
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0",
        "magento/framework": "103.0.*",
        "magento/module-backend": "*",
        "magento/module-config": "*",
        "magento/module-store": "*",
        "zerofront/module-zero-core": "^1.3"
    },
    "replace": {
        "fixstacks/module-zero-instant-navigation": "self.version"
